#!/bin/sh
set -eu

strip_metadata() {
  target="$1"
  [ -e "$target" ] || return 0
  case "$target" in
    *.app|*.appex|*.framework|*.bundle|*.storyboardc)
      # Xcode may point TMPDIR inside the framework currently being built.
      # Keep the metadata-free copy outside all build products.
      tmp_root="/private/tmp/sookta-$(basename "$target").clean.$$"
      rm -rf "$tmp_root"
      ditto --norsrc --noextattr "$target" "$tmp_root" 2>/dev/null || true
      if [ -d "$tmp_root" ]; then
        rm -rf "$target"
        mv "$tmp_root" "$target"
      fi
      ;;
  esac
  find "$target" \( -name '.DS_Store' -o -name '._*' -o -name '__MACOSX' \) -exec rm -rf {} + 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -c {} \; 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -d com.apple.FinderInfo {} \; 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -d com.apple.ResourceFork {} \; 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -d 'com.apple.fileprovider.fpfs#P' {} \; 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -d com.apple.provenance {} \; 2>/dev/null || true
  find "$target" -exec /usr/bin/xattr -d com.apple.quarantine {} \; 2>/dev/null || true
  /usr/bin/xattr -c "$target" 2>/dev/null || true
}

strip_build_metadata() {
  native_assets_root="${SRCROOT:-}/../build/native_assets/ios"
  if [ -d "$native_assets_root" ]; then
    find "$native_assets_root" \( -name '*.framework' -o -name '*.bundle' \) \
      -exec "$0" --strip-only {} \; 2>/dev/null || true
  fi
  strip_metadata "$native_assets_root"
  strip_metadata "${TARGET_BUILD_DIR:-}/App.framework"
  strip_metadata "${TARGET_BUILD_DIR:-}/Flutter.framework"
  strip_metadata "${CONFIGURATION_BUILD_DIR:-}/App.framework"
  strip_metadata "${CONFIGURATION_BUILD_DIR:-}/Flutter.framework"
  strip_metadata "${BUILT_PRODUCTS_DIR:-}/App.framework"
  strip_metadata "${BUILT_PRODUCTS_DIR:-}/Flutter.framework"
}

invalidate_native_assets_for_platform_change() {
  native_assets_root="${SRCROOT:-}/../build/native_assets/ios"
  [ -d "$native_assets_root" ] || return 0

  case "${PLATFORM_NAME:-}" in
    iphoneos) expected_platform="IOS" ;;
    iphonesimulator) expected_platform="IOSSIMULATOR" ;;
    *) return 0 ;;
  esac

  platform_mismatch=0
  while IFS= read -r binary_path; do
    file_description="$(/usr/bin/file -b "$binary_path" 2>/dev/null || true)"
    case "$file_description" in
      *Mach-O*) ;;
      *) continue ;;
    esac

    platforms="$(/usr/bin/xcrun vtool -show-build "$binary_path" 2>/dev/null |
      /usr/bin/awk '$1 == "platform" { print $2 }')"
    for platform_name in $platforms; do
      if [ "$platform_name" != "$expected_platform" ]; then
        platform_mismatch=1
      fi
    done
  done <<EOF
$(find "$native_assets_root" -type f -print)
EOF

  if [ "$platform_mismatch" -eq 1 ]; then
    echo "Sookta: invalidating staged native assets for ${PLATFORM_NAME}; found a different Apple platform." >&2
    rm -rf "$native_assets_root"
  fi
}

if [ "${1:-}" = "--strip-only" ]; then
  strip_metadata "$2"
  exit 0
fi

invalidate_native_assets_for_platform_change
if [ "${1:-}" = "--prepare-native-assets-only" ]; then
  exit 0
fi

run_flutter_build() {
  /bin/sh "$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh" build
}

if run_flutter_build; then
  exit 0
fi

echo "Sookta: Flutter iOS build failed; stripping macOS metadata and retrying once." >&2
strip_build_metadata
run_flutter_build
